  "this.dropAllDeathLoot(source);",
  "this.level.broadcastEntityEvent(this, (byte) 3);",
  "int x = SectionPos.blockToSectionCoord(pos.getX());",
  "LevelChunk chunk = this.getChunk(x, z);",
