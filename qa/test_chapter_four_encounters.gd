extends SceneTree
const FW=preload("res://scripts/chapter_four_world.gd")
var checks:=0
var failures: Array=[]
func _initialize():run.call_deferred()
func check(ok: bool,label: String):
	checks+=1
	if ok:print("PASS: ",label)
	else:failures.append(label);push_error(label)
func fresh():
	var w=FW.new();w.reset(204);w.stage="survival";w.state="RUNNING";w.db.data.chapter_four.exploration_only=true;w.build={};w.items={};w.evolved={};w.props=[];w.threats=[];w.landmarks=[];w.pools={};w.chickens=[]
	return w
func advance(w,seconds: float,move:=Vector2.ZERO):
	for j in range(ceili(seconds*60)):
		if w.state=="LEVEL_UP":w.skip_reward()
		w.step(1.0/60,move)
func mass(w):
	w.player=Vector2(1024,1024);w.encounters.launch_mass(w,Vector2(1024,930));advance(w,4);w.rebuild_hit_grid()
func run():
	var w=fresh();var e=w.encounters
	check(e.mass.is_empty() and e.current.is_empty() and not e.golem.started,"New run starts without an active boss or rescue")
	w.time=149;w.player=e.golem.p;w.db.data.chapter_four.exploration_only=false;w.step(.01)
	check(not e.golem.visible,"Rescue does not appear before its world-time gate")
	w.time=151;w.step(.01)
	check(e.golem.started and e.nodes.size()==3 and e.golem.phase=="intro","Approaching the village starts the golem and exactly three distinct growths")
	w=fresh();e=w.encounters;mass(w)
	check(e.current=="mass" and e.parts.size()==4 and e.mass.mask==15,"Timed mass encounter owns four functional destructible groups")
	check(w.in_radius(e.mass.p,100).any(func(m):return m.id==e.mass.id),"New boss body participates in actual weapon hit queries")
	var head: Dictionary=e.parts[0];var before: float=e.mass.hp;w.damage_owner="shotgun";w.hurt(head,80)
	check(e.mass.hp<before and head.hp==head.max_hp-80 and w.damage_by.shotgun>80,"A selected part takes damage and transmits a bounded share to the core")
	w.hurt(head,999)
	check(e.mass.mask==14 and e.mass.skin=="ch4d_mass_14" and e.loose.size()==1,"Destroying the left head removes that exact visible body group")
	check(e.parts[1].hp>0 and e.parts[2].hp>0,"Focusing a head leaves other functional parts intact")
	advance(w,.25)
	check(head.flash<.12,"A detached part's hit flash decays instead of staying bright forever")
	e.enter(e.mass,"windup",.01,"fan");w.step(.02);advance(w,.5)
	check(not e.shots.is_empty() and e.shots.size()<=int(e.data.rules.shots_limit),"Remaining head emits a bounded sequence of clot streams")
	w.hurt(e.parts[1],999);e.enter(e.mass,"walk",.01);advance(w,.02)
	check(e.mass.cast!="fan","Losing both heads removes the head-stream sequence")
	w.hurt(e.parts[2],999);e.enter(e.mass,"walk",.01);advance(w,.02)
	check(e.mass.cast!="haul","Losing the pulling arms removes their body haul")
	w.hurt(e.parts[3],999)
	check(e.loose.size()<=4 and w.mobs.is_empty(),"Detached anatomy has a fixed limit and never spawns an endless mob wave")
	w=fresh();e=w.encounters;mass(w);e.mass.hp=e.mass.max_hp*.3;w.step(.02)
	check(e.mass.small and e.mass.radius<24 and e.mass.mask==0,"Last phase becomes a smaller faster core with a different attack set")
	w=fresh();e=w.encounters;mass(w);w.player=e.mass.p+Vector2(80,0);e.mass.charge=Vector2.RIGHT;e.enter(e.mass,"windup",1,"sweep")
	before=w.hp;advance(w,.7)
	check(w.hp==before,"Wide sweep's warning is harmless before contact")
	advance(w,.9)
	check(w.hp<before,"A player inside the actual prepared sweep receives ordinary damage")
	w=fresh();e=w.encounters;mass(w);w.hook_target(e.parts[0],true)
	check(e.mass.pull_left>0 and e.mass.control_resist>0,"Hooking an attached part controls the core using boss control protection")
	var pull: float=e.mass.pull_left;w.hook_target(e.parts[0],true)
	check(e.mass.pull_left==pull,"Immediate repeated hooks cannot restart boss control")
	w=fresh();e=w.encounters;mass(w);var snapshot=JSON.stringify([w.clock,e.mass,e.parts,e.shots,e.loose]);w.state="PAUSED";advance(w,2,Vector2.RIGHT)
	check(snapshot==JSON.stringify([w.clock,e.mass,e.parts,e.shots,e.loose]),"Pause freezes the mass, detached anatomy, stream timing and exact poses")
	w.state="RUNNING";w.damage_owner="sword";w.hurt(e.mass,99999);advance(w,4.4)
	check(e.mass_done and e.current.is_empty() and e.loose.is_empty() and e.shots.is_empty(),"Mass death finishes once and cleans its remaining attacks")
	check(w.loot.any(func(l):return l.kind=="chest") and not w.victory and not w.win_music,"Mini-boss reward never finishes the chapter or starts the old victory theme")
	var rewards: int=w.loot.size();advance(w,2)
	check(w.loot.size()==rewards,"A completed mass cannot pay its reward twice")
	w=fresh();e=w.encounters;w.player=e.golem.p+Vector2(60,0);e.launch_golem(w);advance(w,2.4);w.rebuild_hit_grid()
	check(e.nodes.size()==3 and not e.candidates().has(e.golem),"Golem's body is protected while three separate anchors are attackable")
	var node: Dictionary=e.nodes[0];var at: Vector2=node.p;w.hook_target(node,true)
	check(node.p==at and node.pull_left==0,"Rescue anchors cannot be pulled off their physical tethers")
	w.spawn("flayed_zombie",e.golem.p+Vector2(40,0));var mob: Dictionary=w.mobs.back();mob.hp=200;mob.max_hp=200;mob.speed=0;mob.timer=99
	w.rebuild_hit_grid();e.golem.charge=Vector2.RIGHT;e.enter(e.golem,"windup",.01);before=mob.hp;w.step(.02)
	check(mob.hp<before and w.hp<20,"Infected golem's locked heavy strike genuinely hits both the hero and other enemies")
	w.player=e.golem.p+Vector2(80,60);w.damage_owner="bow"
	for n in e.nodes:w.hurt(n,999)
	advance(w,.1)
	check(e.rescued and e.golem.phase=="release" and e.golem.allied,"Destroying all three growths starts the freeing scene")
	snapshot=JSON.stringify([e.golem,e.nodes,w.clock]);w.state="PAUSED";advance(w,1)
	check(snapshot==JSON.stringify([e.golem,e.nodes,w.clock]),"Pause freezes the freeing scene without skipping its turning point")
	w.state="RUNNING";advance(w,3.4);w.rebuild_hit_grid()
	check(e.golem.skin=="ch4d_golem_saved" and e.golem.allied and not e.golem.undead,"Freed golem changes its actual model and allegiance")
	before=e.golem.hp;w.heal_undead(e.golem.p,100,999);w.hurt(e.golem,999)
	check(e.golem.hp==before and not e.candidates().has(e.golem),"Friendly golem is excluded from weapon targeting and healing damage")
	w.spawn("flayed_zombie",e.golem.p+Vector2(50,0));mob=w.mobs.back();mob.hp=200;mob.max_hp=200;mob.speed=0;mob.timer=99;mob.phase="recover";w.rebuild_hit_grid()
	e.golem.charge=Vector2.RIGHT;e.enter(e.golem,"windup",.01);before=mob.hp;var hero: float=w.hp;w.player=e.golem.p+Vector2(55,0);w.step(.02)
	check(mob.hp<before and w.hp==hero and w.damage_by.get("golem_ally",0)>0,"Rescued defender attacks a real enemy without friendly fire and attributes its damage")
	e.golem.help_until=w.clock-1;e.golem.p=e.golem.home+Vector2(90,0);w.mobs=[];e.enter(e.golem,"walk",2);before=e.golem.p.distance_to(e.golem.home);advance(w,.5)
	check(e.golem.p.distance_to(e.golem.home)<before,"After helping with the wave, the golem returns to guard its freed location")
	w=fresh();e=w.encounters;w.player=e.arena().get_center()+Vector2(0,65);e.launch_guardian(w);advance(w,3.8)
	check(e.current=="guardian" and e.nodes.size()==4,"Pyramid encounter wakes its own figure and four controllable torch endpoints")
	var validated:=true
	for pattern in range(8):
		for cell in e.all_cells():
			w.player=e.grid_point(cell);var plan: Array=e.plan_geometry(w,pattern)
			validated=validated and e.connected(plan,cell) and not plan.has(cell)
	check(validated,"All eight corridor proposals keep every starting cell connected to the entry and boss approach")
	w.player=e.arena().get_center()+Vector2(0,70);e.proposal=e.plan_geometry(w,0)
	check(not e.proposal.is_empty(),"Guardian prepares actual upcoming stone cells")
	var chosen: Vector2i=e.proposal[0];var chosen_p: Vector2=e.grid_point(chosen)
	check(w.free_at(chosen_p,6),"Warned geometry remains traversable before activation")
	e.commit_geometry(w)
	check(not w.free_at(chosen_p,6) and w.blocked.has(Vector2i(chosen_p/32)),"Raised image cells have real collision and navigation blocking")
	var end: Vector2=w.move_actor(chosen_p+Vector2(-50,0),Vector2(100,0),6)
	check(end.x<chosen_p.x,"A long dash cannot tunnel through the newly raised stone")
	e.clear_geometry(w)
	check(w.free_at(chosen_p,6) and not w.blocked.has(Vector2i(chosen_p/32)),"Clearing the puzzle removes only its temporary solids and navigation marks")
	e.proposal=e.plan_geometry(w,0);chosen=e.proposal[0];w.player=e.grid_point(chosen);e.commit_geometry(w)
	check(w.free_at(w.player,6) and not e.blocks.has(chosen),"Stepping into a warned tile cancels that tile instead of crushing or trapping the hero")
	e.clear_geometry(w);w.player=e.arena().get_center()+Vector2(0,65);e.plan_beams(w)
	var beam: Dictionary=e.beams[0];w.player=beam.a.lerp(beam.b,.5);before=w.hp;e.update_beams(w,.2)
	check(w.hp==before and not beam.live,"Torch sequence warns before its shared collision segment becomes live")
	e.update_beams(w,.7)
	check(w.hp<before and beam.live,"A live torch segment hits at its actual drawn location")
	e.plan_beams(w);beam=e.beams[0];node=e.nodes.filter(func(n):return n.id==beam.from)[0];w.damage_owner="sword";w.hurt(node,999);before=w.hp;e.update_beams(w,1)
	check(not e.beams.any(func(b):return b.from==node.id or b.to==node.id),"Destroying a torch endpoint cancels every linked queued discharge")
	e.proposal=e.plan_geometry(w,0);e.commit_geometry(w);w.player=e.arena().get_center();e.enter(e.guardian,"attack",2);snapshot=JSON.stringify([e.guardian,e.blocks,e.beams,w.blocked,w.clock]);w.state="PAUSED";advance(w,2)
	check(snapshot==JSON.stringify([e.guardian,e.blocks,e.beams,w.blocked,w.clock]),"Pause freezes live corridors, beams and navigation exactly")
	w.state="RUNNING";w.player=Vector2(800,1000);w.step(.02)
	check(e.current.is_empty() and e.guardian.phase=="dormant" and e.blocks.is_empty(),"Retreat removes the changing geometry and leaves a resumable encounter")
	e.launch_guardian(w);advance(w,3.8);w.damage_owner="sky_tnt";w.hurt(e.guardian,99999);advance(w,4.7)
	check(e.guardian_done and e.blocks.is_empty() and e.beams.is_empty() and not w.victory,"Guardian's collapse clears the arena without prematurely completing IV")
	w.reset(205)
	check(e.current.is_empty() and e.mass.is_empty() and e.nodes.is_empty() and e.loose.is_empty() and e.blocks.is_empty() and not e.rescued,"New run resets every encounter, reward and rescue state")
	print("CHAPTER_FOUR_ENCOUNTERS_RESULT %d checks; %d failures"%[checks,failures.size()]);quit(0 if failures.is_empty() else 1)
