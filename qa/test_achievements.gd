extends SceneTree
const W=preload("res://scripts/campaign_world.gd")
const NW=preload("res://scripts/nether_world.gd")
const EW=preload("res://scripts/end_world.gd")
const Store=preload("res://scripts/achievements.gd")
var checks=0
var failures=[]
func _initialize():run.call_deferred()
func check(ok: bool,label: String):
	checks+=1
	if ok:print("PASS: ",label)
	else:failures.append(label);push_error(label)
func fresh(chapter: int=1):
	var w=EW.new(724) if chapter==3 else NW.new(724) if chapter==2 else W.new(724)
	w.state="RUNNING"
	if chapter>1:w.stage="survival"
	w.db.data.waves=[{"at":0,"rate":0,"weights":{"zombie":1}}];w.db.data.events=[]
	return w
func advance(w, seconds: float):
	for i in range(ceili(seconds*60)):w.step(1.0/60)
func complete_one(w):
	w.finale.begin(w);w.finale.phase="fall";w.finale.phase_age=3.99;w.hp=0
	w.step(.02)
func complete_two(w):
	w.prepare_arena();w.mobs.clear();w.stage="wither";w.spawn("wither",w.player+Vector2(0,-120));w.mobs[0].hp=0;w.resolve_deaths()
func run():
	var w=fresh();complete_one(w)
	check(w.run_progress.awarded.has("chapter_one") and w.finale.complete,"Canonical mandatory fall completes chapter I even though victory=false")
	check(w.run_progress.awarded.has("sword_only"),"Sword-only chapter I accepts the normal starting sword")
	check(w.run_progress.awarded.has("untouched"),"Scripted second-stage death does not count as combat damage")
	check(not w.run_progress.awarded.has("herobrine"),"Losing the first duel does not award the secret victory")
	w=fresh();w.hp=0;w.step(.01);check(not w.run_progress.awarded.has("chapter_one"),"An ordinary early death never completes a chapter")
	w=fresh();w.damage_player(2);w.apply_upgrade("apple");complete_one(w)
	check(not w.run_progress.awarded.has("untouched"),"Healing lost HP cannot erase the no-damage history")
	w=fresh();w.invulnerable=1;w.damage_player(5);complete_one(w)
	check(w.run_progress.awarded.has("untouched"),"Blocked damage does not invalidate no-damage completion")
	w=fresh();w.finale.begin(w);w.finale.phase="storm";w.finale.boss.hp=0;w.step(.01)
	check(w.run_progress.awarded.has("herobrine") and not w.run_progress.awarded.has("chapter_one"),"Actual first-stage defeat awards Victory? before the chapter ends")
	w=fresh();w.build.sword=8;w.items[w.db.recipes.sword.passive]=1;w.open_chest({"born":400.0});complete_one(w)
	check(w.run_progress.awarded.has("first_evolution") and w.run_progress.awarded.has("sword_only"),"Sword development and actual chest evolution preserve sword-only eligibility")
	w=fresh();w.apply_upgrade("bow");w.state="PAUSED";w.discard("bow");complete_one(w)
	check(not w.run_progress.awarded.has("sword_only"),"Immediately removing another weapon cannot restore sword-only history")
	w=fresh();check(w.build=={"sword":1} and not w.has_method("start_with"),"Every normal chapter I attempt starts with the original sword")
	w.track_progress(25);check(w.run_progress.bow_allowed and w.run_progress.bow_exposure.is_empty(),"The untouched starting sword remains valid while the player searches for a bow")
	w.apply_upgrade("bow");w.state="PAUSED";w.discard("sword");w.state="RUNNING";w.apply_upgrade("bow");w.build.bow=8;w.items[w.db.recipes.bow.passive]=1;w.open_chest({"born":400.0});complete_one(w)
	check(w.run_progress.awarded.has("bow_only"),"Found bow upgrades and evolution are permitted after retiring the starting sword")
	check(not w.run_progress.awarded.has("sword_only"),"Taking the bow is never sword-only")
	w=fresh();w.apply_upgrade("bow");advance(w,2.9);w.state="PAUSED";w.discard("sword");complete_one(w)
	check(w.run_progress.awarded.has("bow_only"),"Starting sword removed within three seconds after finding a bow is allowed")
	w=fresh();w.apply_upgrade("bow");advance(w,3.05);w.state="PAUSED";w.discard("sword");complete_one(w)
	check(not w.run_progress.awarded.has("bow_only"),"Holding the starting sword beyond three seconds after finding the bow fails the challenge")
	w=fresh();w.apply_upgrade("sword");w.apply_upgrade("bow");w.state="PAUSED";w.discard("sword");complete_one(w)
	check(not w.run_progress.awarded.has("bow_only"),"Upgrading the initial sword before finding the bow permanently fails the challenge")
	w=fresh();w.apply_upgrade("bow");advance(w,2);w.state="PAUSED";var exposure=w.run_progress.bow_exposure.sword;w.step(10)
	check(w.run_progress.bow_exposure.sword==exposure,"Inventory/pause never advances the three-second allowance")
	w.discard("sword");w.state="RUNNING";w.apply_upgrade("sword");advance(w,1.1);complete_one(w)
	check(not w.run_progress.awarded.has("bow_only"),"Removing and reacquiring the same weapon cannot reset its grace time")
	w=fresh();w.apply_upgrade("trident");w.track_progress(3.1);w.state="PAUSED";w.discard("trident");w.state="RUNNING";w.apply_upgrade("bow");w.state="PAUSED";w.discard("sword");complete_one(w)
	check(not w.run_progress.awarded.has("bow_only"),"A third weapon has no unlimited grace even before the bow is found")
	w=fresh();w.track_progress(12);complete_one(w);check(not w.run_progress.awarded.has("bow_only"),"A chapter completed without ever finding a bow cannot earn Only Arrows")
	w=fresh();w.xp=w.db.required_xp(w.level);w.next_level();w.choices=["bow","trident","potion"];var level=w.level;var rng_before=w.rng.state
	check(w.skip_reward() and w.state=="RUNNING" and w.build=={"sword":1} and w.level==level,"A forced off-weapon reward can be skipped without gear or another level")
	check(w.rng.state==rng_before,"Skipping a reward consumes no combat RNG when no queued level remains")
	complete_one(w);check(w.run_progress.awarded.has("sword_only"),"Skipping preserves the strict sword-only condition")
	w=fresh(3);w.next_level();w.choose(0);check(not w.skip_reward() and not w.chosen_item.is_empty(),"Skip cannot cancel an already confirmed End reward")
	w=fresh(2)
	for id in ["bow","axe","hoe","bed","tnt"]:w.apply_upgrade(id)
	for id in w.db.passives.keys().slice(0,8):w.apply_upgrade(id)
	check(w.run_progress.awarded.has("full_inventory"),"Six real weapons and eight real enhancements award full inventory")
	w.run_progress.drain();w.run_progress.observe(w);check(w.run_progress.drain().is_empty(),"Full inventory does not repeatedly award every frame")
	w=fresh(2);w.apply_upgrade("axe");complete_two(w)
	check(w.run_progress.awarded.has("chapter_two") and w.run_progress.awarded.has("two_weapons"),"Actual Wither defeat completes chapter II with at most two occupied weapon slots")
	check(w.run_progress.awarded.has("no_evolutions") and w.run_progress.awarded.has("no_healing"),"Chapter II can award no-evolutions and no-consumables together")
	w=fresh(2);w.apply_upgrade("axe");w.apply_upgrade("bow");w.state="PAUSED";w.discard("bow");w.state="RUNNING";complete_two(w)
	check(not w.run_progress.awarded.has("two_weapons"),"Removing the third weapon cannot erase peak slot occupancy")
	w=fresh(2);w.build.axe=8;w.items[w.db.recipes.axe.passive]=1;w.open_chest({"born":400.0});w.state="PAUSED";w.discard("axe");w.state="RUNNING";complete_two(w)
	check(not w.run_progress.awarded.has("no_evolutions"),"Removing an evolved weapon never restores no-evolutions eligibility")
	for heal in ["apple","golden_carrot"]:
		w=fresh(2);w.apply_upgrade(heal);complete_two(w)
		check(not w.run_progress.awarded.has("no_healing"),"Picking up %s counts as using a heal even at full health" % heal)
	w=fresh(2);w.items.ghast_tear=5;w.hp=8;w.regen_tick=0;w.step(.01);check(w.hp>8 and not w.run_progress.healing_used,"Ghast-tear regeneration is permitted")
	w.prepare_arena();check(not w.run_progress.healing_used,"Story healing at arena arrival is permitted")
	w=fresh(2);w.prepare_arena();w.mobs.clear();w.stage="wither";w.spawn("wither",w.player-Vector2(0,100));w.mobs[0].hp=0;w.hp=0;w.resolve_deaths();check(not w.run_progress.awarded.has("chapter_two"),"A simultaneous player death does not award chapter II completion")
	w=fresh(3);w.hp=8;w.build={};w.loot.append({"kind":"chorus_fruit","p":w.player,"source":w.player});w.pickup(.01)
	check(w.run_progress.healing_used,"A successful chorus teleport records actual consumable healing")
	w=fresh(3);w.build={};w.spawn("endermite_brood",w.player);w.mobs[0].radius=300;w.loot.append({"kind":"chorus_fruit","p":w.player,"source":w.player});w.pickup(.01)
	check(not w.run_progress.healing_used and w.loot.filter(func(o):return o.kind=="chorus_fruit").size()==1,"An uneaten chorus with no safe landing is not a used heal")
	w=fresh(3);w.prepare_arena();w.mobs.clear();w.stage="dragon";w.spawn("end_dragon",w.player-Vector2(0,100));w.mobs[0].hp=0;w.resolve_deaths()
	check(not w.run_progress.awarded.has("chapter_three") and not w.win_music,"Dragon alone does not finish chapter III or start final victory audio")
	w.stage="last_duel";w.spawn("endersteve_final",w.player-Vector2(0,100));w.mobs[0].hp=0;w.resolve_deaths()
	check(not w.win_music,"EnderSteve's death scene retains its fight soundtrack until the body dissolves")
	advance(w,7.7)
	check(w.run_progress.awarded.has("chapter_three") and w.run_progress.awarded.has("no_evolutions") and w.run_progress.awarded.has("no_healing"),"The final defeat completes chapter III and its clean-run conditions")
	check(w.win_music and w.boss_victory_serial==1 and w.sounds.has("boss_win"),"Final End victory emits the existing stinger and selects victory music once")
	advance(w,2);check(w.boss_victory_serial==1,"Waiting for the hand never repeats the victory sound")
	w=fresh();preload("res://scripts/boss_lab.gd").equip(w,0);w.run_progress.observe(w);complete_one(w)
	check(w.run_progress.awarded.is_empty(),"Boss laboratory grants no achievements")
	w=fresh(3);var rng=w.rng.state;w.run_progress.observe(w);w.run_progress.step(w,.01);w.run_progress.damage(2);w.run_progress.healing()
	check(w.rng.state==rng,"Achievement tracking never consumes combat RNG")
	w.reset(724);check(not w.run_progress.completed and not w.run_progress.healing_used and w.run_progress.damage_taken==0,"A new run clears all attempt-specific restrictions")
	var store=Store.new();var file="user://qa_achievements_%d.json" % OS.get_process_id();store.load_profile(file)
	check(store.catalog.size()==19 and store.catalog.filter(func(e):return e.tier=="easy").size()==5 and store.catalog.filter(func(e):return e.tier=="medium").size()==8 and store.catalog.filter(func(e):return e.tier=="hard").size()==5,"Catalog contains the twelve original and six version 2 achievements plus the chapter V fatality in their difficulty groups")
	check(store.unlock("chapter_one") and not store.unlock("chapter_one") and not store.unlock("unknown_id"),"Profile accepts known awards exactly once")
	store.unlock("herobrine");var loaded=Store.new();loaded.load_profile(file)
	check(loaded.unlocked.has("chapter_one") and loaded.unlocked.has("herobrine") and loaded.pending.is_empty(),"Earned achievements survive loading without repeating old notifications")
	FileAccess.open(file,FileAccess.WRITE).store_string("{broken");loaded.load_profile(file)
	check(loaded.recovered and loaded.unlocked.size()==2,"A corrupt primary profile recovers the last valid achievements backup")
	loaded.unlock("chapter_two");var recovered=Store.new();recovered.load_profile(file)
	check(recovered.unlocked.size()==3,"Saving after backup recovery preserves earlier unlocks")
	for suffix in ["",".bak",".tmp"]:DirAccess.remove_absolute(ProjectSettings.globalize_path(file+suffix))
	FileAccess.open("res://qa/achievements_results.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures},"  "))
	print("ACHIEVEMENTS_RESULT ",checks," checks; ",failures.size()," failures");quit(0 if failures.is_empty() else 1)
