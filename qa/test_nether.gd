extends SceneTree
const World=preload("res://scripts/nether_world.gd")
const Campaign=preload("res://scripts/campaign_world.gd")
var failures=[]
var checks=0
func _initialize():run.call_deferred()
func check(ok: bool, label: String):
	checks+=1
	if not ok:failures.append(label);push_error(label)
	else:print("PASS: "+label)
func fresh():
	var w=World.new(724)
	w.state="RUNNING"
	return w
func advance(w, seconds: float):
	for i in range(ceili(seconds*60)):w.step(1.0/60)
func run():
	var w=fresh()
	check(w.build=={"sword":1} and w.stage=="survival" and w.hp==20,"Chapter II starts with iron sword and clean health")
	check(w.props.filter(func(p):return p.type=="pumpkin").size()==32 and w.magma.size()>10,"Nether has breakable pots and magma")
	check(w.db.weapons.size()==12 and w.db.passives.size()==10,"Previous and new upgrades share the pool")
	for id in ["sword","axe","hoe"]:
		check(w.db.equipment_icon(id,1)==id+"_iron" and w.db.equipment_icon(id,4)==id+"_diamond" and w.db.equipment_icon(id,8)==id+"_netherite",id+" material progression")
	check(w.db.stats("axe",1).radius<w.db.stats("sword",1).radius and w.db.stats("axe",1).interval>w.db.stats("sword",1).interval,"Axe has shorter reach and slower interval than sword")
	w.build={"axe":1}
	for angle in [0,PI/2,PI,PI*1.5]:w.spawn("zoglin",w.player+Vector2.from_angle(angle)*24)
	w.rebuild_hit_grid();w.update_attacks(.01)
	check(w.mobs.all(func(m):return m.hp<m.max_hp),"Axe hits all four directions in one attack")
	w=fresh();w.build={"hoe":1};w.spawn("brute",w.player+Vector2(65,0));w.rebuild_hit_grid();w.update_attacks(.01)
	for i in range(40):w.update_projectiles(1.0/60);w.update_effects(1.0/60)
	var spins=w.effects.filter(func(e):return e.kind=="hoe_spin")
	check(spins.size()==1 and spins[0].p.distance_to(w.mobs[0].p)<10,"Hoe anchors at first enemy contact")
	var hp=w.mobs[0].hp
	w.update_effects(.31)
	check(w.mobs[0].hp<hp,"Anchored hoe deals repeated area ticks")
	w=fresh();w.build={"fishing":1};w.spawn("zoglin",w.player+Vector2(110,0));w.rebuild_hit_grid();w.update_attacks(.01)
	for i in range(40):w.update_projectiles(1.0/60)
	check(w.mobs[0].pull_left>0 and w.mobs[0].pull_dir.x<0,"Fishing hook pulls an enemy toward the player")
	w=fresh();w.build={"bed":1};w.place_explosive("bed",w.db.stats("bed",1));var b=w.explosives[0]
	w.update_explosives(1)
	check(w.explosives.size()==1,"Bed waits on the ground until approached")
	w.player=b.p+Vector2(10,0);w.update_explosives(.01)
	check(w.explosives.is_empty() and w.hp==20 and w.effects.any(func(e):return e.kind=="foot_block"),"Approaching bed places protection and triggers explosion")
	w=fresh();w.build={"tnt":8};w.evolved.tnt=true
	w.place_explosive("tnt",w.db.stats("tnt",8,true))
	check(w.explosives.size()==1 and w.tnt_groups.size()==1,"Evolved TNT places a detonator and schedules four directional charges")
	for i in range(91):w.update_explosives(1.0/60)
	check(w.explosives.size()==4 and w.explosives.all(func(e):return e.launched and e.v.length()>0),"First TNT blast launches the four remaining charges")
	for i in range(240):w.update_explosives(1.0/60)
	check(w.explosives.is_empty(),"Launched TNT all detonate without leftover charges")
	w=fresh();w.build={"crossbow":8};w.evolved.crossbow=true;w.spawn("brute",w.player+Vector2(50,0));w.rebuild_hit_grid();w.update_attacks(.01)
	check(w.projectiles.all(func(p):return p.kind=="rocket"),"Evolved crossbow fires rockets")
	for i in range(40):w.update_projectiles(1.0/60)
	check(w.mobs[0].hp<w.mobs[0].max_hp and w.effects.any(func(e):return e.kind=="explosion"),"Rockets explode and damage enemies")
	w=fresh();w.items={"gold_boots":1};w.spawn("piglin_sword",w.player+Vector2(70,0));w.spawn("brute",w.player+Vector2(120,0));w.rebuild_hit_grid()
	var pig=w.mobs[0]
	check(w.neutral(pig) and not w.neutral(w.mobs[1]),"Gold calms ordinary piglins, never a brute")
	w.hurt(pig,1)
	check(not w.neutral(pig),"First player hit provokes piglin")
	w.move_mobs(15)
	check(w.neutral(pig),"Piglin forgives after its aggression timer")
	w=fresh();w.fire_damage(2);var unprotected=20-w.hp
	w=fresh();w.items={"fire_resist":5};w.fire_damage(2)
	check(is_equal_approx(20-w.hp,unprotected*.2),"Fire resistance reduces fire damage by 80 percent at V")
	w.invulnerable=0;var before=w.hp;w.damage_player(2)
	check(is_equal_approx(before-w.hp,2),"Fire resistance leaves physical damage unchanged")
	w=fresh();w.player=w.magma[0].p;w.update_fire(.01)
	check(w.player_burn>0 and w.hp<20,"Magma ignites and damages the player")
	w=fresh();w.items={"ghast_tear":5};w.hp=10;w.regen_tick=.001;w.step(.01)
	check(is_equal_approx(w.hp,11.5),"Ghast tear restores health using the simulation clock")
	w=fresh();var pot=w.props.filter(func(p):return p.type=="pumpkin" and p.has_heal)[0];pot.hp=0;w.break_pumpkin(pot)
	check(w.loot.size()==1 and w.loot[0].kind=="golden_carrot","Pots drop golden carrots without emeralds")
	w.hp=10;w.player=pot.p;w.pickup(.01)
	check(w.hp==16,"Golden carrot heals six HP")
	w=fresh()
	for i in range(10):
		for id in w.db.weapons:w.apply_upgrade(id)
		for id in w.db.passives:w.apply_upgrade(id)
	check(w.build.size()==6 and w.items.size()==8,"Independent caps are six weapons and eight passives")
	check(not w.make_choices().has("emerald"),"Full inventory fallback has no emeralds")
	w.state="PAUSED";w.tasks.append({"kind":"sword","wait":.1})
	check(w.discard("sword") and not w.build.has("sword") and w.tasks.is_empty(),"Inventory deletion removes weapon and pending attacks")
	w.apply_upgrade("fishing");check(w.build.has("fishing"),"Deleted weapon frees a slot")
	check(w.discard("blaze") and w.items.size()==7,"Passive deletion frees a separate slot")
	w.state="RUNNING";check(not w.discard("fishing"),"Deletion is only permitted while inventory pauses the world")
	for id in World.NEW_WEAPONS:
		w=fresh();w.build={id:8};w.items={w.db.recipes[id].passive:1};w.open_chest({"born":360.0})
		check(w.evolved.has(id),id+" evolves from its recipe")
	w=fresh();w.time=719.99;var before_position=w.player;var props_count=w.props.size();w.step(.02)
	check(w.stage=="departure" and w.time==720 and w.player==before_position and w.props.size()==props_count,"12 minutes start a fade before moving to the arena")
	advance(w,1.65)
	check(w.stage=="arrival" and w.props.is_empty() and w.magma.is_empty(),"Arena changes under the transition fade")
	advance(w,World.INTRO_DURATION+.05)
	check(w.stage=="wither" and w.mobs.size()==1 and w.mobs[0].kind=="wither","Cinematic arrival releases a single Wither")
	check(int(w.animation.data.actors.wither.frame_size[0])==128 and int(w.animation.data.actors.wither.frame_size[1])==112 and w.animation.data.actors.wither.columns==46,"Larger Wither has dedicated attack and death frames")
	var boss=w.mobs[0];w.rebuild_hit_grid();w.projectiles.clear();boss.attack_tick=0;w.tracked_velocity=Vector2.RIGHT*82;w.move_mobs(.01)
	check(boss.phase=="volley" and w.projectiles.is_empty() and boss.mark.x>w.player.x,"Wither telegraphs a lead ahead of player movement")
	w.move_mobs(1)
	check(w.projectiles.size()==9,"Three heads fire denser three-shot fans")
	w.hazards.clear();w.encounter.begin(w,boss,"bombard")
	w.encounter.bombard_step(w,boss,.37)
	check(w.hazards.size()==3 and w.hazards.all(func(h):return h.kind=="soul"),"Bombardment schedules three fast predictive ignitions")
	w.encounter.begin(w,boss,"dash");boss.timer=0;w.move_mobs(.01);var start=boss.p;w.move_mobs(.1)
	check(boss.phase=="rush" and boss.p.distance_to(start)>20,"Telegraphed dash moves the actual boss")
	w.projectiles.clear();w.encounter.begin(w,boss,"spiral");boss.timer=0;w.move_mobs(.01);w.move_mobs(.01)
	check(w.projectiles.size()>=12,"Spiral releases crossing streams across the full circle")
	boss.hp=boss.max_hp*.4;w.move_mobs(.01)
	check(boss.rage and boss.phase=="roar","Half health transitions through a separate roar animation")
	boss.phase="walk";boss.pattern=0;boss.attack_tick=0;w.projectiles.clear();w.move_mobs(.01);w.move_mobs(1)
	check(w.projectiles.size()==15,"Rage fires five-shot fans from all three heads")
	for pause in ["PAUSED","LEVEL_UP","CHEST"]:
		w.state=pause;var clock=w.clock;var p=w.player;w.step(4,Vector2.RIGHT)
		check(w.clock==clock and w.player==p,"Boss and transition clocks freeze in "+pause)
	w.state="RUNNING";boss.hp=1;w.hurt(boss,10);w.resolve_deaths()
	check(w.stage=="defeat" and w.victory and w.mobs.is_empty() and not w.defeated_boss.is_empty(),"Boss death enters the collapse cinematic")
	advance(w,2.9)
	check(w.stage=="portal" and w.loot.any(func(o):return o.kind=="ender_eye"),"Collapse leaves a pearl and inactive portal")
	for o in w.loot:
		if o.kind=="ender_eye":w.player=o.p
	w.pickup(.01);w.player=w.portal_position+Vector2(42,0);w.step(.01)
	check(w.stage=="lighting" and not w.pearl and not w.portal_lit,"Approach starts a visible pearl-lighting sequence")
	advance(w,1.9)
	check(w.portal_lit and w.stage=="portal","The portal opens after its ignition animation")
	w.player=w.portal_position;w.step(.01)
	check(w.stage=="jump","Walking into the lit portal starts the jump without a button")
	advance(w,4.2)
	check(w.stage=="end" and w.state=="RESULT" and w.victory,"Animated jump reaches the End")
	w.reset(724)
	check(w.stage=="survival" and not w.portal_lit and not w.pearl and not w.victory and w.build=={"sword":1},"Retry resets boss, portal, inventory and status")
	var original=preload("res://scripts/world.gd").new(724)
	check(original.db.weapons.size()==6 and original.db.passives.size()==6,"Original world used by coop retains its balance")
	var solo=Campaign.new(724);solo.state="RUNNING";solo.break_pumpkin(solo.props.filter(func(p):return p.type=="pumpkin" and p.has_heal)[0])
	check(solo.loot[0].kind=="apple","Chapter I solo no longer drops emeralds")
	FileAccess.open("res://qa/nether_results.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures},"  "))
	print("NETHER_RESULT ",checks," checks; ",failures.size()," failures")
	quit(0 if failures.is_empty() else 1)
